# Variáveis lidas automaticamente pelo Docker Compose (este arquivo É versionado).
# NÃO coloque segredos aqui — para segredos use env inline no compose ou um
# arquivo .env.<algo> (ignorado pelo git).

# Nome do projeto Compose: isola containers/volumes/rede deste deploy. Em outro
# ambiente (ex.: produção num path separado) altere para evitar colisão de
# containers entre paths — ex.: shadowindex-prod. Também dá para sobrescrever sem
# editar o arquivo: export COMPOSE_PROJECT_NAME=shadowindex-prod
COMPOSE_PROJECT_NAME=shadowindex

# Porta HTTP publicada no host -> acesse em http://localhost:${WEB_PORT}
WEB_PORT=3000
